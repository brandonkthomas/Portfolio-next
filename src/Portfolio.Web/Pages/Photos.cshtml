@page "/photos"
@model PhotosModel
@* Renders preview-size photos; each link targets the full-size image so the grid works without JavaScript *@

<header class="page-heading">
    <h1>Photos</h1>
</header>

@if (Model.Photos.Count == 0)
{
    <p class="empty-state">Nothing here right now. Check back later!</p>
}
else
{
    @* Preloads the lightbox module and supplies its fingerprinted URL across enhanced navigation *@
    <link rel="modulepreload" href="~/assets/js/photos.js" data-photo-module>
    <ol class="photo-list" data-photo-list>
        @for (var index = 0; index < Model.Photos.Count; index++)
        {
            var photo = Model.Photos[index];
            var formats = photo.Variants
                .GroupBy(variant => variant.MediaType)
                .Select(format => format.OrderBy(variant => variant.Width).ToArray())
                .ToArray();
            var fallback = formats.FirstOrDefault(format => format[0].MediaType == "image/jpeg") ?? formats[0];
            var preview = fallback[0];

            <li>
                <figure class="photo">
                    <a href="@fallback[^1].Url" aria-label="Open full-size photo: @photo.AltText" data-photo-trigger>
                        @* The grid requests only the smallest variant; the lightbox activates the full candidate lists on open *@
                        <picture>
                            @foreach (var format in formats.Where(format => format != fallback))
                            {
                                <source type="@format[0].MediaType"
                                        srcset="@format[0].Url"
                                        data-lightbox-srcset="@PhotosModel.FormatSrcset(format)">
                            }
                            <img src="@preview.Url"
                                 data-lightbox-srcset="@PhotosModel.FormatSrcset(fallback)"
                                 width="@preview.Width"
                                 height="@preview.Height"
                                 alt="@photo.AltText"
                                 loading="@(index < 4 ? "eager" : "lazy")"
                                 decoding="async">
                        </picture>
                    </a>
                    @* <figcaption> *@
                    @*     @if (photo.Caption is not null) *@
                    @*     { *@
                    @*         <span>@photo.Caption</span> *@
                    @*     } *@
                    @*     <time datetime="@photo.PublishedAt.ToString("yyyy-MM-dd")">@photo.PublishedAt.ToString("MMMM yyyy")</time> *@
                    @* </figcaption> *@
                </figure>
            </li>
        }
    </ol>
}
