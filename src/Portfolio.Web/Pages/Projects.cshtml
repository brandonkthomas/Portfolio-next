@page "/projects"
@model ProjectsModel
@* Renders server-provided project records + their optional external links *@
@{
    var tagIcons = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        [".NET Core"] = "dotnet",
        ["TypeScript"] = "typescript",
        ["Three.js"] = "threejs",
        ["CSS"] = "css",
        ["C#"] = "c-sharp",
        ["WPF"] = "dotnet",
        ["Windows"] = "windows",
        ["Shell"] = "bash",
        ["CLI"] = "terminal",
        ["Swift"] = "swift",
        ["SwiftUI"] = "swift"
    };
}

<header class="page-heading">
    <h1>Projects</h1>
</header>

<partial name="_ProjectTagSymbols" />

<ol class="project-list">
    @foreach (var project in Model.Projects)
    {
        <li>
            <article class="project">
                @* Title w/ optional decorative icon; Razor rewrites only literal ~/ paths, so the image tag helper resolves this catalog path to its fingerprinted URL *@
                <h2>
                    @if (project.Icon is not null)
                    {
                        <img class="project-icon@(project.Icon.InvertInDarkTheme ? " monochrome-icon" : null)"
                             src="@("~" + project.Icon.Path)"
                             asp-append-version="true"
                             width="64"
                             height="64"
                             alt="">
                    }
                    else
                    {
                        <img class="project-icon" src="~/assets/svg/project-placeholder.svg" width="64" height="64" alt="">
                    }
                    @if (project.SourceUrl is not null)
                    {
                        <a href="@project.SourceUrl" rel="external" aria-label="View @project.Title on GitHub">@project.Title</a>
                    }
                    else
                    {
                        @project.Title
                    }
                </h2>
                
                @* Caption *@
                @if (project.Meta is not null)
                {
                    <p class="subtitle-meta">@project.Meta</p>
                }

                @* Summary *@
                <p>@project.Summary</p>

                @* Tags (technologies) *@
                <ul class="tag-list" aria-label="Technologies">
                    @foreach (var tag in project.Tags)
                    {
                        <li>
                            @if (tagIcons.TryGetValue(tag, out var iconName))
                            {
                                <svg class="tag-icon" aria-hidden="true" focusable="false">
                                    <use href="#tag-icon-@iconName"></use>
                                </svg>
                            }
                            <span>@tag</span>
                        </li>
                    }
                </ul>

                @* URLs / downloads *@
                @if (project.LiveUrl is not null || project.Downloads.Count > 0)
                {
                    <ul class="project-links" aria-label="Links for @project.Title">
                        @if (project.LiveUrl is not null)
                        {
                            <li><a href="@project.LiveUrl" rel="@(project.LiveUrl.StartsWith('/') ? null : "external")" aria-label="Open @project.Title">Visit</a></li>
                        }
                        @foreach (var download in project.Downloads)
                        {
                            <li><a href="@download.Url" rel="external" aria-label="Download @project.Title for @download.Label">Download for @download.Label</a></li>
                        }
                    </ul>
                }
            </article>
        </li>
    }
</ol>
